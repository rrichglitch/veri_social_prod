# ============================================================================
# Veri Social frontend build config — THE single file that differs between
# the dev and production deployments. Everything else is identical code.
#
# Dev repo (this one)  -> deploys to test.veri.social -> repsoc  database
# Production repo       -> deploys to veri.social     -> verisocial database
# ============================================================================

# SpacetimeDB backend gate (Vite inlines these at build time)
VITE_STDB_HOST=maincloud.spacetimedb.com
VITE_STDB_MODULE=verisocial

# OAuth relay (shared by both deployments)
VITE_AUTH_RELAY_URL=https://auth.veri.social

# Leave empty unless hosting under a sub-path
VITE_BASE_PATH=
